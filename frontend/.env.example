# Frontend environment (Vite). Copy to `.env.local` for local overrides.

# Leave empty in development to use the Vite proxy (`/api`, `/health`).
# In production, set the absolute API origin, e.g. https://api.example.com
VITE_API_BASE_URL=

# Dev-server proxy target for FastAPI
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
