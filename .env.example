# IncidentIQ environment configuration.
# Copy to `.env` and adjust for your environment. Never commit `.env`.

# --- Application ---
# One of: development | staging | production | test
APP_ENV=development

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Infrastructure (required in most environments) ---
DATABASE_URL=postgresql://incidentiq:incidentiq@localhost:5432/incidentiq
REDIS_URL=redis://localhost:6379/0

# --- Background workers ---
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
CELERY_DEFAULT_QUEUE=investigation
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_BACKOFF_SECONDS=60
CELERY_TASK_RETRY_BACKOFF_MAX_SECONDS=600

# --- Optional services (leave blank to disable) ---
# PROMETHEUS_URL is for the Prometheus connector (querying an external server).
# Self-metrics are always at GET /metrics and do not require Prometheus running.
# Docker Compose `full` profile sets these via infrastructure/full.env.
OPENSEARCH_URL=
PROMETHEUS_URL=

# --- AI providers ---
# AI_MODE: local | cloud | hybrid
# Docker Compose `minimal`/`full` profiles force AI_MODE=local + in-compose Ollama
# so the stack runs without cloud AI keys. See infrastructure/README.md.
AI_MODE=local

# Ollama (local provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_SMALL=
OLLAMA_MODEL_LARGE=

# Which Ollama model size the RCA engine uses: small | large
RCA_MODEL=large

# Groq (optional cloud provider). Secret — keep out of source control.
GROQ_API_KEY=
GROQ_MODEL=

# Fernet key for encrypting connector credentials at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in production. Optional in development (a local key is derived).
CONNECTOR_SECRET_KEY=

# HMAC secret for user JWT access tokens.
# Required in production. Optional in development (a local key is derived).
JWT_SECRET_KEY=
# JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720

# First-time bootstrap (POST /api/v1/auth/bootstrap).
# Empty = disabled automatically in production; set true/false to override.
# AUTH_BOOTSTRAP_DISABLED=

# Rate limits (per client IP).
# AUTH_LOGIN_RATE_LIMIT=10
# AUTH_BOOTSTRAP_RATE_LIMIT=5
# AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# UPLOAD_RATE_LIMIT=30
# UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
# ALERTMANAGER_MAX_ALERTS_PER_WEBHOOK=200

# Fallback behaviour
AI_ENABLE_FALLBACK=false
# AI_FALLBACK_PROVIDER: ollama | groq
AI_FALLBACK_PROVIDER=groq

# RCA generation tuning
RCA_TEMPERATURE=0.1
RCA_MAX_TOKENS=2048

INVESTIGATION_INGEST_CHUNK_SIZE=1000
INVESTIGATION_ARTIFACT_ID_LIMIT=200

# --- Log uploads ---
LOG_UPLOAD_DIR=data/uploads
LOG_UPLOAD_MAX_BYTES=104857600
LOG_UPLOAD_CHUNK_BYTES=1048576

# --- Error-group similarity ---
ERROR_SIMILARITY_HIGH_CONFIDENCE_MIN=0.92
ERROR_SIMILARITY_POSSIBLE_MATCH_MIN=0.75
