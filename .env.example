# IncidentIQ environment configuration.
# Copy to `.env` and adjust for your environment. Never commit `.env`.

# --- Application ---
# One of: development | staging | production | test
APP_ENV=development

# --- Infrastructure (required in most environments) ---
DATABASE_URL=postgresql://incidentiq:incidentiq@localhost:5432/incidentiq
REDIS_URL=redis://localhost:6379/0

# --- Optional services (leave blank to disable) ---
OPENSEARCH_URL=
PROMETHEUS_URL=

# --- AI providers ---
# AI_MODE: local | cloud | hybrid
AI_MODE=local

# Ollama (local provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_SMALL=
OLLAMA_MODEL_LARGE=

# Which Ollama model size the RCA engine uses: small | large
RCA_MODEL=large

# Groq (optional cloud provider). Secret — keep out of source control.
GROQ_API_KEY=
GROQ_MODEL=

# Fallback behaviour
AI_ENABLE_FALLBACK=false
# AI_FALLBACK_PROVIDER: ollama | groq
AI_FALLBACK_PROVIDER=groq

# RCA generation tuning
RCA_TEMPERATURE=0.1
RCA_MAX_TOKENS=2048

# --- Log uploads ---
LOG_UPLOAD_DIR=data/uploads
LOG_UPLOAD_MAX_BYTES=104857600
LOG_UPLOAD_CHUNK_BYTES=1048576

# --- Error-group similarity ---
ERROR_SIMILARITY_HIGH_CONFIDENCE_MIN=0.92
ERROR_SIMILARITY_POSSIBLE_MATCH_MIN=0.75
